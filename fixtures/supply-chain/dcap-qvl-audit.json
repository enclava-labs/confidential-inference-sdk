{
  "schema": "confidential-inference.dcap-qvl-audit.v1",
  "review_date": "2026-07-26",
  "scope": "Upstream dcap-qvl dependency, review policy, lockfile, and TDX/DCAP evidence used by the SDK.",
  "upstream_sync_policy": {
    "path": "docs/dcap-qvl-upstream-sync.md",
    "required_release_gate": true,
    "review_triggers": [
      "production release enabling offline TDX/DCAP",
      "resolved dcap-qvl or dcap-qvl-webpki version change",
      "RustSec advisory affecting DCAP verifier dependencies",
      "Intel DCAP quote or collateral validation requirement change",
      "enabled QVL feature or cryptographic backend change",
      "real evidence, malformed-input, or mutation corpus change"
    ],
    "required_commands": [
      "cargo test -p confidential-inference-providers --test dcap_qvl_audit --locked",
      "cargo test -p confidential-inference-attestation dcap_tdx_malformed_corpus --locked",
      "cargo test -p confidential-inference-attestation dcap_tdx_mutation_sweep --locked",
      "cargo test --workspace --locked",
      "cargo deny check",
      "cargo audit --ignore RUSTSEC-2023-0071"
    ]
  },
